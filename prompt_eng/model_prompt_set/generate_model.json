      ]
    }
  },
  {
    "model": {
      "id": "symmetric_matrix",
      "name": "2D Symmetric Matrix",
      "domain": "matrix",
      "description": "A symmetric matrix where both row and column are enumerations of the same set, and each cell represents a symmetric relationship.",
