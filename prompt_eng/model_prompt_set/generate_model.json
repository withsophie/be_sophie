        },
        {
          "id": "{col_define_set}",
          "prototype": "set",
          "define_baseset": ["primitive"],
          "define_prompt": "The set that defines all possible column entities (e.g., years, indicators).",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{dimension_row}",
          "prototype": "dimension",
          "define_baseset": ["{row_define_set}"],
          "define_prompt": "Row dimension, each value is an entity from row_define_set.",
