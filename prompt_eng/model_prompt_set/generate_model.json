[
  {
    "model": {
      "id": "base_model",
      "name": "Base Model",
      "domain": "geometry",
      "description": "Base structure for all models.",
      "inherits": null,
      "entities": [
        {
          "id": "base_entity",
          "prototype": "point",
          "define_baseset": [],
          "define_prompt": "",
          "occur": 1,
          "inherits": null,
          "value": ""
        }
      ]
     
    }
  },
  {
    "model": {
      "id": "binary_orthogonal",
      "name": "Binary Orthogonal",
      "domain": "geometry",
      "description": "A quadrant model using two conceptual axes (X and Y) to form four composite quadrant entities.",
      "inherits": "base_model",
      "entities": [
        {
          "id": "{axis_x}",
          "prototype": "axis",
          "define_baseset": ["primitive"],
          "define_prompt": "The X-axis representing opposing conceptual vectors.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{axis_y}",
          "prototype": "axis",
          "define_baseset": ["primitive"],
          "define_prompt": "The Y-axis representing another set of conceptual vectors.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{x_positive}",
          "prototype": "vector",
          "define_baseset": ["{axis_x}"],
          "define_prompt": "Positive direction on X-axis. (e.g., future on a time axis, advantage in a competition)",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{x_negative}",
          "prototype": "vector",
          "define_baseset": ["{axis_x}"],
          "define_prompt": "Negative direction on X-axis. (e.g., past on a time axis, disadvantage in a competition)",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{y_positive}",
          "prototype": "vector",
          "define_baseset": ["{axis_y}"],
          "define_prompt": "Positive direction on Y-axis. (e.g., growth, opportunity)",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{y_negative}",
          "prototype": "vector",
          "define_baseset": ["{axis_y}"],
          "define_prompt": "Negative direction on Y-axis. (e.g., decline, threat)",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{quadrant_I}",
          "prototype": "quadrant",
          "define_baseset": ["{x_positive}", "{y_positive}","{ThinkPoint}"],
          "define_prompt": "Find all of {ThinkPoint}= {x_positive} and {y_positive} ",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{quadrant_II}",
          "prototype": "quadrant",
          "define_baseset": ["{x_negative}", "{y_positive}"],
          "define_prompt": "Second quadrant (X negative, Y positive).",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{quadrant_III}",
          "prototype": "quadrant",
          "define_baseset": ["{x_negative}", "{y_negative}"],
          "define_prompt": "Third quadrant (X negative, Y negative).",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{quadrant_IV}",
          "prototype": "quadrant",
          "define_baseset": ["{x_positive}", "{y_negative}"],
          "define_prompt": "Fourth quadrant (X positive, Y negative).",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{x_flip}",
          "prototype": "symmetry",
          "define_baseset": ["axis_x"],
          "define_prompt": "Horizontal axis symmetry—conversion between positive and negative X (e.g., Quadrant I <-> IV, II <-> III).",
          "occur": "1+",
          "inherits": "base_relation"
        },
        {
          "id": "{y_flip}",
          "prototype": "symmetry",
          "define_baseset": ["axis_y"],
          "define_prompt": "Vertical axis symmetry—conversion between positive and negative Y (e.g., Quadrant I <-> II, IV <-> III).",
          "occur": "1+",
          "inherits": "base_relation"
        },
        {
          "id": "{diagonal_reverse}",
          "prototype": "symmetry",
          "define_baseset": ["x_flip", "y_flip"],
          "define_prompt": "Diagonal reverse—equivalent to applying both x_flip and y_flip in sequence. Maps Quadrant I (++) to Quadrant III (--), i.e., both axes flipped.",
          "occur": "1+",
          "inherits": "base_relation"
        },
        {
          "id": "{diagonal_swap}",
          "prototype": "symmetry",
          "define_baseset": ["x_flip", "y_flip"],
          "define_prompt": "Diagonal swap—equivalent to applying both x_flip and y_flip in sequence. Maps Quadrant II (-+) to Quadrant IV (+-), i.e., both axes flipped but swaps the off-diagonal quadrants.",
          "occur": "1+",
          "inherits": "base_relation"
        }
      ]
    }
  },
  {
    "model": {
      "id": "trinary_triangle",
      "name": "Trinary Interconnection",
      "domain": "geometry",
      "description": "A triangular model showing interaction among three conceptual entities.",
      "inherits": "base_model",
      "entities": [
        {
          "id": "{node_a}",
          "prototype": "node",
          "define_baseset": ["primitive"],
          "define_prompt": "Vertex A in the triangle.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{node_b}",
          "prototype": "node",
          "define_baseset": ["primitive"],
          "define_prompt": "Vertex B in the triangle.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{node_c}",
          "prototype": "node",
          "define_baseset": ["primitive"],
          "define_prompt": "Vertex C in the triangle.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{edge_ab}",
          "prototype": "edge",
          "define_baseset": ["{node_a}", "{node_b}"],
          "define_prompt": "Edge between node A and node B.",
          "occur": "1+",
          "inherits": "base_relation"
        },
        {
          "id": "{edge_bc}",
          "prototype": "edge",
          "define_baseset": ["{node_b}", "{node_c}"],
          "define_prompt": "Edge between node B and node C.",
          "occur": "1+",
          "inherits": "base_relation"
        },
        {
          "id": "{edge_ca}",
          "prototype": "edge",
          "define_baseset": ["{node_c}", "{node_a}"],
          "define_prompt": "Edge between node C and node A.",
          "occur": "1+",
          "inherits": "base_relation"
        }
      ]
    }
  },
  {
    "model": {
      "id": "negative_feedback_opposition",
      "name": "Binary Negative Feedback Opposition",
      "domain": "analytic_geometry",
      "description": "Two opposing nodes interact via negative feedback functions, driving the system toward a dynamic equilibrium.",
      "inherits": "base_model",
      "entities": [
        {
          "id": "{node_a}",
          "prototype": "point",
          "define_baseset": ["primitive"],
          "define_prompt": "Opposing Node A.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{node_b}",
          "prototype": "point",
          "define_baseset": ["primitive"],
          "define_prompt": "Opposing Node B.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{change_path}",
          "prototype": "segment",
          "define_baseset": ["{node_a}", "{node_b}"],
          "define_prompt": "The path of change (line segment) connecting Node A and Node B.",
          "occur": 1,
          "inherits": "base_relation"
        },
        {
          "id": "{equilibrium}",
          "prototype": "point",
          "define_baseset": ["{node_a}", "{node_b}", "{change_path}"],
          "define_prompt": "Dynamic equilibrium point between Node A and Node B.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        }
      ],
      "relations": [
        {
          "id": "{activation_a_to_b}",
          "prototype": "function",
          "define_baseset": ["{node_a}"],
          "define_prompt": "Function mapping from Node A to Node B (A influences B).",
          "occur": 1,
          "inherits": "base_relation"
        },
        {
          "id": "{activation_b_to_a}",
          "prototype": "function",
          "define_baseset": ["{node_b}"],
          "define_prompt": "Function mapping from Node B to Node A (B influences A).",
          "occur": 1,
          "inherits": "base_relation"
        },
        {
          "id": "{negative_feedback_a_to_b}",
          "prototype": "function",
          "define_baseset": ["{node_a}"],
          "define_prompt": "Negative feedback from Node A to Node B (suppresses A, promotes B).",
          "occur": 1,
          "inherits": "base_relation"
        },
        {
          "id": "{negative_feedback_b_to_a}",
          "prototype": "function",
          "define_baseset": ["{node_b}"],
          "define_prompt": "Negative feedback from Node B to Node A (suppresses B, promotes A).",
          "occur": 1,
          "inherits": "base_relation"
        }
      ]
    }
  },
  {
    "model": {
      "id": "Venn",
      "name": "Venn diagram",
      "domain": "set",
      "description": "Models the relationship between any sets, focusing only on their intersections and unions.",
      "inherits": "base_model",
      "entities": [
        {
          "id": "{set}",
          "prototype": "set",
          "define_baseset": ["primitive"],
          "define_prompt": "user defined set",
          "occur": "n+",
          "inherits": "base_entity",
          "value": ""
        }
      ],
      "relations": [
        {
          "id": "{intersection_pair}",
          "prototype": "set_operation",
          "define_baseset": ["{set_i}", "{set_j}"],
          "define_prompt": "Intersection of any two sets",
          "occur": "n*",
          "inherits": "base_relation"
        },
        {
          "id": "{intersection_n}",
          "prototype": "set_operation",
          "define_baseset": ["{set_1}", "{set_2}", "...", "{set_n}"],
          "define_prompt": "Intersection of any n sets",
          "occur": "n*",
          "inherits": "base_relation"
        },
        {
          "id": "{intersection_all}",
          "prototype": "set_operation",
          "define_baseset": ["{set_1}", "{set_2}", "...", "{set_n}"],
          "define_prompt": "Intersection of all sets",
          "occur": 1,
          "inherits": "base_relation"
        },
        {
          "id": "{union_pair}",
          "prototype": "set_operation",
          "define_baseset": ["{set_i}", "{set_j}"],
          "define_prompt": "Union of any two sets",
          "occur": "n*",
          "inherits": "base_relation"
        },
        {
          "id": "{union_n}",
          "prototype": "set_operation",
          "define_baseset": ["{set_1}", "{set_2}", "...", "{set_n}"],
          "define_prompt": "Union of any n sets",
          "occur": "n*",
          "inherits": "base_relation"
        },
        {
          "id": "{union_all}",
          "prototype": "set_operation",
          "define_baseset": ["{set_1}", "{set_2}", "...", "{set_n}"],
          "define_prompt": "Union of all sets",
          "occur": 1,
          "inherits": "base_relation"
        }
      ]
    }
  },
  {
    "model": {
      "id": "central_expansion",
      "name": "Central Expansion Model",
      "domain": "geometry",
      "description": "A model with a center (origin), expansion (radius), boundary (circumference), interior, and exterior. Relations include expansion and contraction.",
      "inherits": "base_model",
      "entities": [
        {
          "id": "{origin}",
          "prototype": "point",
          "define_baseset": ["primitive"],
          "define_prompt": "The central point (origin) of the circle.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{radius}",
          "prototype": "segment",
          "define_baseset": ["{origin}"],
          "define_prompt": "The radius starting from the center (origin) and extending toward the boundary.",
          "occur": 1,
          "inherits": "base_relation"
        },
        {
          "id": "{boundary}",
          "prototype": "circle",
          "define_baseset": ["{origin}", "{radius}"],
          "define_prompt": "The boundary (circumference) of the circle.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{interior}",
          "prototype": "region",
          "define_baseset": ["{boundary}"],
          "define_prompt": "The interior region within the boundary.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        },
        {
          "id": "{exterior}",
          "prototype": "region",
          "define_baseset": ["{boundary}"],
          "define_prompt": "The exterior region outside the boundary.",
          "occur": 1,
          "inherits": "base_entity",
          "value": ""
        }
      ],
      "relations": [
        {
          "id": "{expansion}",
          "prototype": "function",
          "define_baseset": ["{origin}", "{boundary}"],
          "define_prompt": "Expansion from the center toward the boundary.",
          "occur": 1,
          "inherits": "base_relation"
        },
        {
          "id": "{contraction}",
          "prototype": "function",
          "define_baseset": ["{boundary}", "{origin}"],
          "define_prompt": "Contraction from the boundary toward the center.",
          "occur": 1,
          "inherits": "base_relation"
        }
      ]
    }
  },
  {
    "model": {
      "id": "hybrid_matrix",
